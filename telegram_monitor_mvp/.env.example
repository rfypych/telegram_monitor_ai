# Your Telegram API Credentials (get from https://my.telegram.org)
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# Session name for Telethon (creates a .session file)
SESSION_NAME=my_monitor_session

# Target Channels (usernames or invite links, comma separated)
TARGET_CHANNELS=@example_channel1,@example_channel2

# Output CSV file name
OUTPUT_FILE=scraped_listings.csv

# Optional: OpenAI Key for advanced valuation later
OPENAI_API_KEY=sk-...
